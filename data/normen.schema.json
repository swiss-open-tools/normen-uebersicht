{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swiss-open-tools/normen-uebersicht/data/normen.schema.json",
  "title": "Normen-Übersicht Tiefbau Schweiz – Datensatz",
  "description": "Nur bibliografische Metadaten. Keine Inhalte, Auszüge oder Zusammenfassungen von Normtexten.",
  "type": "object",
  "required": [
    "schema_version",
    "stand",
    "eintraege"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "stand": {
      "type": "string",
      "format": "date",
      "description": "Datum der letzten Datenpflege (YYYY-MM-DD)"
    },
    "hinweis": {
      "type": "string"
    },
    "eintraege": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/eintrag"
      }
    }
  },
  "$defs": {
    "datum": {
      "description": "Ausgabe als Jahr (2019), Monat (2019-06) oder Tag (2019-06-01) – nur was die Quelle belegt",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(19|20)\\d{2}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "eintrag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "herausgeber",
        "herausgeber_name",
        "ebene",
        "typ",
        "nummer",
        "titel",
        "ausgabe",
        "status",
        "themen",
        "url",
        "kostenlos",
        "quelle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Eindeutig, stabil, z. B. vss-sn-640-324 oder tg-tba-237-441"
        },
        "herausgeber": {
          "type": "string",
          "minLength": 2,
          "maxLength": 12,
          "description": "Kurzzeichen, z. B. VSS, SIA, VSA, ASTRA, BAFU, Bund, TBA TG"
        },
        "herausgeber_name": {
          "type": "string",
          "minLength": 3
        },
        "ebene": {
          "enum": [
            "national",
            "kanton",
            "gemeinde"
          ]
        },
        "kanton": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(AG|AI|AR|BE|BL|BS|FR|GE|GL|GR|JU|LU|NE|NW|OW|SG|SH|SO|SZ|TG|TI|UR|VD|VS|ZG|ZH)$"
        },
        "gemeinde": {
          "type": [
            "string",
            "null"
          ]
        },
        "typ": {
          "enum": [
            "Norm",
            "Richtlinie",
            "Normalie",
            "Merkblatt",
            "Weisung",
            "Vollzugshilfe",
            "Leitfaden",
            "Empfehlung",
            "Reglement",
            "Gesetz",
            "Verordnung",
            "Fachhandbuch",
            "Dokumentation",
            "Musterpflichtenheft",
            "Checkliste",
            "Vorlage",
            "Verzeichnis"
          ]
        },
        "nummer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Offizielle Nummer, Schreibweise wie beim Herausgeber (z. B. «SN 640 324», «SIA 118», «SR 814.20», «237.441»)"
        },
        "titel": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Offizieller Titel, wörtlich"
        },
        "ausgabe": {
          "$ref": "#/$defs/datum"
        },
        "status": {
          "enum": [
            "gültig",
            "ersetzt",
            "Entwurf",
            "in Überarbeitung",
            null
          ],
          "description": "Nur setzen, wenn die Quelle es belegt"
        },
        "themen": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Oberbau",
              "Entwässerung",
              "Leitungsbau",
              "Signalisation",
              "Markierung",
              "Beleuchtung",
              "Baustellen",
              "Velo/Fussverkehr",
              "Geometrie/Projektierung",
              "Randabschlüsse",
              "Verkehrssicherheit",
              "Strassenraum/Nutzung",
              "Lärmschutz",
              "Umwelt",
              "Gewässerschutz",
              "Verträge/Honorare",
              "Ausschreibung/Abrechnung",
              "Kunstbauten",
              "Geodaten/Vermessung",
              "Recht"
            ]
          }
        },
        "stichworte": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optionale Suchbegriffe (eigene Worte, keine Normzitate)"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "Offizielle Bezugs-/Downloadseite des Herausgebers"
        },
        "kostenlos": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true = frei herunterladbar, false = kostenpflichtig, null = unklar"
        },
        "quelle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "geprueft_am"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://",
              "description": "Seite/Dokument, das Nummer/Titel/Ausgabe belegt"
            },
            "geprueft_am": {
              "type": "string",
              "format": "date"
            },
            "notiz": {
              "type": "string"
            }
          }
        },
        "bemerkung": {
          "type": "string",
          "maxLength": 300,
          "description": "Nur formale Hinweise (z. B. «ersetzt Ausgabe 2008»), keine Inhalte"
        }
      }
    }
  }
}